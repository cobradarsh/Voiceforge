		<key>cell</key>
		<string>PSLinkCell</string>
		<key>label</key>
		<string>VoiceForge</string>
	</dict>
	<key>title</key>
	<string>VoiceForge</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Voice</string>
			<key>footerText</key>
			<string>The voice is applied to your microphone during calls. Change it here or with the waveform button on the call screen (drag it to move it). In the in-call menu, Custom shows pitch values from 0.7 to 2.0; formants follow automatically.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enabled</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.voiceforge.prefs</string>
			<key>PostNotification</key>
			<string>com.voiceforge/prefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>In-call button</string>
			<key>key</key>
			<string>inCallButton</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.voiceforge.prefs</string>
			<key>PostNotification</key>
			<string>com.voiceforge/prefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>label</key>
			<string>Voice</string>
			<key>key</key>
			<string>preset</string>
			<key>default</key>
			<integer>0</integer>
			<key>defaults</key>
			<string>com.voiceforge.prefs</string>
			<key>PostNotification</key>
			<string>com.voiceforge/prefs</string>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>4</integer>
				<integer>3</integer>
				<integer>1</integer>
				<integer>2</integer>
				<integer>5</integer>
				<integer>6</integer>
				<integer>7</integer>
			</array>
			<key>validTitles</key>
			<array>
				<string>Normal (Off)</string>
				<string>Female</string>
				<string>Deep Narrator</string>
				<string>Dark Lord</string>
				<string>Tenor</string>
				<string>Smurf</string>
				<string>Chipmunk</string>
				<string>Custom</string>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Custom voice</string>
			<key>footerText</key>
			<string>Used when Voice is Custom. Pitch moves the note you speak at; Formant moves the size of the voice. For reference: Female is pitch 1.70 / formant 1.18, Deep Narrator is 0.82 / 0.90. Keeping formant between 1.0 and the pitch value sounds most natural.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSStaticTextCell</string>
			<key>label</key>
			<string>Pitch</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>key</key>
			<string>customPitch</string>
			<key>min</key>
			<real>0.5</real>
			<key>max</key>
			<real>2.5</real>
			<key>default</key>
			<real>1.3</real>
			<key>showValue</key>
			<true/>
			<key>defaults</key>
			<string>com.voiceforge.prefs</string>
			<key>PostNotification</key>
			<string>com.voiceforge/prefs</string>
