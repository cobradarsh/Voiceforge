			<string>alwaysOn</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.voiceforge.prefs</string>
			<key>PostNotification</key>
			<string>com.voiceforge/prefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Discovery logging</string>
			<key>key</key>
			<string>debugLog</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.voiceforge.prefs</string>
			<key>PostNotification</key>
			<string>com.voiceforge/prefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
