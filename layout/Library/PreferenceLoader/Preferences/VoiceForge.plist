			<string>targetSpec</string>
			<key>default</key>
			<string>auto</string>
			<key>placeholder</key>
			<string>auto</string>
			<key>autoCaps</key>
			<string>none</string>
			<key>noAutoCorrect</key>
			<true/>
			<key>defaults</key>
			<string>com.voiceforge.prefs</string>
			<key>PostNotification</key>
			<string>com.voiceforge/prefs</string>
